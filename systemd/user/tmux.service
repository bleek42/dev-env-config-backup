[Unit]
Description=tmux basic session (detached)
Description=Terminal Multiplexer (tmux) basic session
Documentation=man:tmux(1)
Conflcts=tmux-session@.socket

[Service]
Type=forking
Environment=DISPLAY=:0
ExecStart=/usr/bin/tmux new-session -d
ExecStop=/home/bleek42/.config/tmux/plugins/tmux-resurrect/scripts/save.sh
ExecStop=/usr/bin/tmux kill-server
KillMode=control-group


