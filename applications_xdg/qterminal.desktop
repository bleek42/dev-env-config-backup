[Desktop Entry]
Name=QTerminal
Type=Application
GenericName=Terminal emulator
Comment=Terminal emulator
Categories=Qt;System;TerminalEmulator;
Icon=utilities-terminal
Actions=Dropdown;
Exec=/usr/bin/uwsm-app -u=qterminal.scope -s=session.slice -- qterminal
Terminal=false

[Desktop Action Dropdown]
Name=Drop-down Terminal
Exec=/usr/bin/uwsm-app -s=session.slice -- qterminal --drop
Icon=utilities-terminal
