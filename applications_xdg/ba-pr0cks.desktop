[Desktop Entry]
Name=pr0cks
Icon=utilities-terminal
Comment=python script setting up a transparent proxy to forward all TCP and DNS traffic through a SOCKS / SOCKS5 or HTTP(CONNECT) proxy using iptables -j REDIRECT target.
TryExec=/usr/bin/uwsm-terminal /usr/bin/pr0cks
Exec=/usr/bin/sh -c '/usr/bin/pr0cks;$SHELL'
StartupNotify=true
Terminal=true
Type=Application
Categories= X-BlackArch-Proxy; X-BlackArch-Tunnel; X-BlackArch-Networking;
