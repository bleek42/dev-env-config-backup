[Desktop Entry]
Name=Gscriptor
Comment=Send commands to smart cards
Comment[fr]=Envoyer des commandes à des cartes à puce
Comment[ru]=Отправка команд на смарт-карты
Exec=/usr/bin/uwsm-app -t=service -- gscriptor
Terminal=false
Type=Application
Categories=Utility;GTK;
Keywords=smartcard;apdu;
Icon=/usr/share/pcsc/gscriptor.png
