[Desktop Entry]
Name=lf
Type=Application
Comment=Launches the lf file manager.
Categories=ConsoleOnly;System;FileTools;FileManager
Icon=utilities-terminal
TryExec=/usr/bin/uwsm-app -s=session.slice -- footclient -d=info -T=lf /usr/bin/lf
Exec=/usr/bin/uwsm-app -s=session.slice -- /usr/bin/lf
Terminal=true
MimeType=inode/directory;
