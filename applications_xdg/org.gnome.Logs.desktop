[Desktop Entry]
Name=Logs
Type=Application
GenericName=Log Viewer
Categories=GTK;GNOME;System;Monitor;Utility;
Comment=View detailed event logs for the system
Keywords=log;journal;debug;error;
Icon=org.gnome.Logs
Exec=/usr/bin/uwsm-app -- gnome-logs
Terminal=false
StartupNotify=true
DBusActivatable=true
Actions=new-window;

[Desktop Action new-window]
Exec=/usr/bin/uwsm-app -- gnome-logs --new-window
Name=New Window
